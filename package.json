{
  "name": "@ntgovernment/web-design-tokens",
  "version": "3.0.0",
  "description": "Design tokens for the NT Government web design system — CSS custom properties and JS/TS token objects.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.cjs",
  "module": "./dist/index.mjs",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.mjs",
      "require": "./dist/index.cjs",
      "types": "./dist/index.d.ts"
    },
    "./css": "./dist/css/index.css",
    "./css/common": "./dist/css/common.css",
    "./css/grid": "./dist/css/grid.css",
    "./css/typography": "./dist/css/typography.css",
    "./css/typography-literals": "./dist/css/typography-literals.css",
    "./css/base-variables": "./dist/css/base-variables.css",
    "./css/theme-ntg": "./dist/css/themes/theme-ntg.css",
    "./css/theme-central": "./dist/css/themes/theme-central.css",
    "./css/typography-ntg": "./dist/css/themes/typography-ntg.css",
    "./css/typography-central": "./dist/css/themes/typography-central.css",
    "./tokens.json": "./tokens.json"
  },
  "files": [
    "dist/",
    "tokens.json",
    "README.md"
  ],
  "scripts": {
    "tokens:validate": "node scripts/validate-tokens.js",
    "tokens:build": "node scripts/build-tokens.js",
    "build:js": "node scripts/generate-js-tokens.js",
    "build": "npm run tokens:validate && npm run tokens:build && npm run build:js",
    "prepublishOnly": "npm run build"
  },
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "restricted"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/ntgovernment/web-design-tokens.git"
  },
  "keywords": [
    "design-tokens",
    "css-variables",
    "css-custom-properties",
    "nt-government",
    "northern-territory",
    "design-system",
    "theme",
    "figma",
    "typescript"
  ]
}
